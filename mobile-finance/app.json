{
  "expo": {
    "name": "Amanah Finance",
    "slug": "amanah-finance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.amanahdrive.finance",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "com.amanahdrive.finance",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "notification": {
        "icon": "./assets/notification-icon.png",
        "color": "#059669"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#059669"
        }
      ],
      "expo-updates",
      "expo-local-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Aplikasi memerlukan akses galeri foto untuk mengunggah bukti transaksi.",
          "cameraPermission": "Aplikasi memerlukan akses kamera untuk memotret nota atau kuitansi transaksi."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "amanah-finance-app"
      }
    }
  }
}
